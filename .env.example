# ===============================================================
# Fantasy Record Book - API Authentication Credentials
# ===============================================================

# ---------------------------------------------------------------
# 1. ESPN Fantasy Football API (Pride Guys)
# ---------------------------------------------------------------
# Your ESPN League ID (found in URL: leagueId=XXXXXX)
ESPN_LEAGUE_ID=

# Season Year (e.g. 2024, 2025, 2026)
ESPN_SEASON=2026

# Private League Session Cookies (from espn.com browser DevTools -> Cookies)
# espn_s2 is ~200 characters long starting with 'AEB...'
ESPN_S2=
# SWID is in UUID format: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_SWID=


# ---------------------------------------------------------------
# 2. Yahoo Fantasy Sports API (Y2K Record Book)
# ---------------------------------------------------------------
# Yahoo Developer App Credentials (from https://developer.yahoo.com/apps/)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Yahoo League Key (e.g. 'nfl.l.123456' or '449.l.123456')
YAHOO_LEAGUE_KEY=

# OAuth Tokens (Generated via 'node scripts/test_yahoo_auth.js --oauth')
YAHOO_ACCESS_TOKEN=
YAHOO_REFRESH_TOKEN=
